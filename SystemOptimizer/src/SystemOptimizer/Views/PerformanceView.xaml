<UserControl x:Class="SystemOptimizer.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Memory + actions -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource SectionHeader}" Text="Memory" />
                <TextBlock>
                    <Run Text="In use: " />
                    <Run Text="{Binding Memory.UsedDisplay, Mode=OneWay}" FontWeight="Bold" />
                    <Run Text=" of " />
                    <Run Text="{Binding Memory.TotalDisplay, Mode=OneWay}" />
                    <Run Text="   ·   Available: " />
                    <Run Text="{Binding Memory.AvailableDisplay, Mode=OneWay}" FontWeight="Bold" />
                </TextBlock>
                <Grid Margin="0,6,0,0" Width="420" HorizontalAlignment="Left">
                    <ProgressBar Height="18" Maximum="100"
                                 Value="{Binding Memory.UsedPercent, Mode=OneWay}"
                                 Foreground="{Binding Memory.UsedPercent, Converter={StaticResource UsedPercentToBrush}}" />
                    <TextBlock Text="{Binding Memory.UsedPercent, StringFormat={}{0}%}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <Button Content="Clear standby cache" Command="{Binding ClearStandbyCommand}"
                        ToolTip="Flushes cached (standby) memory — like RAMMap. Handy before a big game/app; not needed routinely." />
                <TextBlock Style="{StaticResource Hint}" TextAlignment="Center" Width="200"
                           Text="Frees cached RAM on demand. You usually don't need this — Windows manages RAM well." />
            </StackPanel>
        </Grid>

        <!-- Power plan -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,4" VerticalAlignment="Center">
            <TextBlock Text="Power plan:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Text="{Binding ActivePowerPlan}" VerticalAlignment="Center" Margin="0,0,16,0"
                       Foreground="{StaticResource AccentBrush}" />
            <Button Content="Balanced" Command="{Binding SetPowerPlanCommand}"
                    CommandParameter="Balanced" Style="{StaticResource SecondaryButton}" />
            <Button Content="High performance" Command="{Binding SetPowerPlanCommand}"
                    CommandParameter="HighPerformance" Style="{StaticResource SuccessButton}" />
            <Button Content="Ultimate" Command="{Binding SetPowerPlanCommand}"
                    CommandParameter="Ultimate" Style="{StaticResource SuccessButton}" />
            <Button Content="Power saver" Command="{Binding SetPowerPlanCommand}"
                    CommandParameter="PowerSaver" Style="{StaticResource SecondaryButton}" />
        </StackPanel>

        <!-- Visual effects -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,8" VerticalAlignment="Center">
            <TextBlock Text="Visual effects:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Button Content="Best performance" Command="{Binding SetVisualEffectsCommand}"
                    CommandParameter="BestPerformance" Style="{StaticResource SuccessButton}"
                    ToolTip="Turn off animations/transparency for a snappier feel." />
            <Button Content="Best appearance" Command="{Binding SetVisualEffectsCommand}"
                    CommandParameter="BestAppearance" Style="{StaticResource SecondaryButton}" />
            <Button Content="Let Windows decide" Command="{Binding SetVisualEffectsCommand}"
                    CommandParameter="LetWindowsDecide" Style="{StaticResource SecondaryButton}" />
        </StackPanel>

        <!-- Processes -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Style="{StaticResource SectionHeader}"
                       Text="Top processes by memory (live)" />
            <DataGrid Grid.Row="1" ItemsSource="{Binding Processes}" AutoGenerateColumns="False"
                      CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column"
                      RowHeight="24" GridLinesVisibility="Horizontal"
                      BorderBrush="{StaticResource BorderBrushSoft}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Process" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80" />
                    <DataGridTextColumn Header="Memory" Binding="{Binding WorkingSetDisplay}" Width="120" />
                    <DataGridTemplateColumn Header="Action" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="End" Margin="2" Padding="8,2"
                                        Style="{StaticResource DangerButton}"
                                        Command="{Binding DataContext.KillProcessCommand,
                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Button Content="Refresh now" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding Status}" Foreground="#6B7280" HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
