<UserControl x:Class="SystemOptimizer.Views.JunkCleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource SectionHeader}"
                   Text="Clean temporary files and caches" />
        <TextBlock Grid.Row="1" Style="{StaticResource Hint}"
                   Text="Scan finds safe-to-remove junk. Items go to the Recycle Bin unless you choose permanent delete. Caches rebuild automatically." />

        <DataGrid Grid.Row="2" ItemsSource="{Binding Categories}" AutoGenerateColumns="False"
                  CanUserAddRows="False" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" RowHeight="30"
                  BorderBrush="{StaticResource BorderBrushSoft}">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Clean" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="55" />
                <DataGridTextColumn Header="Category" Binding="{Binding Name}" Width="220" IsReadOnly="True" />
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" IsReadOnly="True" />
                <DataGridTextColumn Header="Files" Binding="{Binding FileCount}" Width="70" IsReadOnly="True" />
                <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="90" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Text="{Binding Summary}" FontWeight="SemiBold" Margin="0,10,0,6" />

        <Grid Grid.Row="4">
            <StackPanel Orientation="Horizontal">
                <Button Content="Scan" Command="{Binding ScanCommand}" />
                <Button Content="Clean selected" Command="{Binding CleanCommand}" />
                <CheckBox Content="Permanent delete (skip Recycle Bin)"
                          IsChecked="{Binding PermanentDelete}" VerticalAlignment="Center"
                          Margin="8,0,0,0" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                <ProgressBar Height="6" Width="240" Value="{Binding Progress}" Maximum="100"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding Status}" Foreground="#6B7280" Margin="0,4,0,0"
                           HorizontalAlignment="Right" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
