<Window x:Class="SystemOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SystemOptimizer.Views"
        Title="System Optimizer" Height="760" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="White" FontFamily="Segoe UI" FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1F2937" Padding="18,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🛠" FontSize="22" Margin="0,0,10,0" Foreground="White" />
                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Tabs -->
        <TabControl Grid.Row="1" Margin="10" BorderThickness="0">
            <TabItem Header="Duplicate Finder">
                <views:DuplicateFinderView DataContext="{Binding DuplicateFinder}" />
            </TabItem>
            <TabItem Header="Junk &amp; Temp Cleanup">
                <views:JunkCleanupView DataContext="{Binding JunkCleanup}" />
            </TabItem>
            <TabItem Header="Startup &amp; Bloatware">
                <views:StartupManagerView DataContext="{Binding StartupManager}" />
            </TabItem>
            <TabItem Header="Disk Health &amp; Space">
                <views:DiskHealthView DataContext="{Binding DiskHealth}" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
